              "//\n",
              "//      http://www.apache.org/licenses/LICENSE-2.0\n",
              "//\n",
              "// Unless required by applicable law or agreed to in writing, software\n",
              "// distributed under the License is distributed on an \"AS IS\" BASIS,\n",
              "// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n",
              "// See the License for the specific language governing permissions and\n",
              "// limitations under the License.\n",
              "\n",
              "/**\n",
              " * @fileoverview Helpers for google.colab Python module.\n",
              " */\n",
              "(function(scope) {\n",
              "function span(text, styleAttributes = {}) {\n",
              "  const element = document.createElement('span');\n",
              "  element.textContent = text;\n",
              "  for (const key of Object.keys(styleAttributes)) {\n",
              "    element.style[key] = styleAttributes[key];\n",
              "  }\n",
              "  return element;\n",
              "}\n",
              "\n",
              "// Max number of bytes which will be uploaded at a time.\n",
              "const MAX_PAYLOAD_SIZE = 100 * 1024;\n",
              "\n",
              "function _uploadFiles(inputId, outputId) {\n",
              "  const steps = uploadFilesStep(inputId, outputId);\n",
              "  const outputElement = document.getElementById(outputId);\n",
              "  // Cache steps on the outputElement to make it available for the next call\n",
              "  // to uploadFilesContinue from Python.\n",
              "  outputElement.steps = steps;\n",
              "\n",
              "  return _uploadFilesContinue(outputId);\n",
              "}\n",
              "\n",
              "// This is roughly an async generator (not supported in the browser yet),\n",
              "// where there are multiple asynchronous steps and the Python side is going\n",
              "// to poll for completion of each step.\n",
              "// This uses a Promise to block the python side on completion of each step,\n",
              "// then passes the result of the previous step as the input to the next step.\n",
              "function _uploadFilesContinue(outputId) {\n",
              "  const outputElement = document.getElementById(outputId);\n",
              "  const steps = outputElement.steps;\n",
              "\n",
              "  const next = steps.next(outputElement.lastPromiseValue);\n",
              "  return Promise.resolve(next.value.promise).then((value) => {\n",
              "    // Cache the last promise value to make it available to the next\n",
              "    // step of the generator.\n",
              "    outputElement.lastPromiseValue = value;\n",
              "    return next.value.response;\n",
              "  });\n",
              "}\n",
              "\n",
              "/**\n",
              " * Generator function which is called between each async step of the upload\n",
              " * process.\n",
              " * @param {string} inputId Element ID of the input file picker element.\n",
              " * @param {string} outputId Element ID of the output display.\n",
              " * @return {!Iterable<!Object>} Iterable of next steps.\n",
              " */\n",
              "function* uploadFilesStep(inputId, outputId) {\n",
              "  const inputElement = document.getElementById(inputId);\n",
              "  inputElement.disabled = false;\n",
              "\n",
              "  const outputElement = document.getElementById(outputId);\n",
              "  outputElement.innerHTML = '';\n",
              "\n",
              "  const pickedPromise = new Promise((resolve) => {\n",
              "    inputElement.addEventListener('change', (e) => {\n",
              "      resolve(e.target.files);\n",
              "    });\n",
              "  });\n",
              "\n",
              "  const cancel = document.createElement('button');\n",
              "  inputElement.parentElement.appendChild(cancel);\n",
              "  cancel.textContent = 'Cancel upload';\n",
              "  const cancelPromise = new Promise((resolve) => {\n",
              "    cancel.onclick = () => {\n",
              "      resolve(null);\n",
              "    };\n",
              "  });\n",
              "\n",
              "  // Wait for the user to pick the files.\n",
              "  const files = yield {\n",
              "    promise: Promise.race([pickedPromise, cancelPromise]),\n",
              "    response: {\n",
              "      action: 'starting',\n",
              "    }\n",
              "  };\n",
              "\n",
              "  cancel.remove();\n",
              "\n",
              "  // Disable the input element since further picks are not allowed.\n",
              "  inputElement.disabled = true;\n",
              "\n",
              "  if (!files) {\n",
              "    return {\n",
              "      response: {\n",
              "        action: 'complete',\n",
              "      }\n",
              "    };\n",
              "  }\n",
              "\n",
              "  for (const file of files) {\n",
              "    const li = document.createElement('li');\n",
              "    li.append(span(file.name, {fontWeight: 'bold'}));\n",
              "    li.append(span(\n",
              "        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n",
              "        `last modified: ${\n",
              "            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n",
              "                                    'n/a'} - `));\n",
              "    const percent = span('0% done');\n",
              "    li.appendChild(percent);\n",
              "\n",
              "    outputElement.appendChild(li);\n",
              "\n",
              "    const fileDataPromise = new Promise((resolve) => {\n",
              "      const reader = new FileReader();\n",
              "      reader.onload = (e) => {\n",
              "        resolve(e.target.result);\n",
              "      };\n",
              "      reader.readAsArrayBuffer(file);\n",
              "    });\n",
              "    // Wait for the data to be ready.\n",
              "    let fileData = yield {\n",
              "      promise: fileDataPromise,\n",
              "      response: {\n",
              "        action: 'continue',\n",
              "      }\n",
              "    };\n",
              "\n",
              "    // Use a chunked sending to avoid message size limits. See b/62115660.\n",
              "    let position = 0;\n",
              "    do {\n",
              "      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n",
              "      const chunk = new Uint8Array(fileData, position, length);\n",
              "      position += length;\n",
              "\n",
              "      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n",
              "      yield {\n",
              "        response: {\n",
              "          action: 'append',\n",
              "          file: file.name,\n",
              "          data: base64,\n",
              "        },\n",
              "      };\n",
              "\n",
              "      let percentDone = fileData.byteLength === 0 ?\n",
              "          100 :\n",
              "          Math.round((position / fileData.byteLength) * 100);\n",
              "      percent.textContent = `${percentDone}% done`;\n",
              "\n",
              "    } while (position < fileData.byteLength);\n",
              "  }\n",
              "\n",
              "  // All done.\n",
              "  yield {\n",
              "    response: {\n",
              "      action: 'complete',\n",
              "    }\n",
              "  };\n",
              "}\n",
              "\n",
              "scope.google = scope.google || {};\n",
              "scope.google.colab = scope.google.colab || {};\n",
              "scope.google.colab._files = {\n",
              "  _uploadFiles,\n",
              "  _uploadFilesContinue,\n",
              "};\n",
              "})(self);\n",
              "</script> "
            ]
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 2. LOAD BBC (truncate to first sentence = headline-length) ----------------\n",
        "bbc_df = pd.read_csv(bbc_file)\n",
        "bbc_df = bbc_df[['text', 'category']].dropna()\n",
        "\n",
        "def first_sentence(text):\n",
        "    sents = sent_tokenize(text)\n",
        "    return sents[0] if sents else text\n",
        "\n",
        "bbc_df['text'] = bbc_df['text'].apply(first_sentence)\n",
        "bbc_df['source'] = 'bbc'"
      ],
      "metadata": {
        "id": "qA2MG9roXdOM"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 3. LOAD HUFFPOST ----------------\n",
        "huffpost_df = pd.read_json(huffpost_file, lines=True)\n",
        "huffpost_df['text'] = huffpost_df['headline'] + \" \" + huffpost_df['short_description'].fillna(\"\")\n",
        "huffpost_df = huffpost_df[['text', 'category']].dropna()\n",
        "huffpost_df['source'] = 'huffpost'"
      ],
      "metadata": {
        "id": "UZNWGuoaXgP8"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 4. CATEGORY MAPPING (reconcile taxonomies into expanded 12-category taxonomy) ----------------\n",
        "category_map = {\n",
        "    # sport\n",
        "    'SPORTS': 'sport',\n",
        "    # tech\n",
        "    'TECH': 'tech',\n",
        "    # politics\n",
        "    'POLITICS': 'politics',\n",
        "    'WORLD NEWS': 'politics',\n",
        "    'WORLDPOST': 'politics',\n",
        "    'THE WORLDPOST': 'politics',\n",
        "    'U.S. NEWS': 'politics',\n",
        "    # business\n",
        "    'BUSINESS': 'business',\n",
        "    'MONEY': 'business',\n",
        "    # entertainment\n",
        "    'ENTERTAINMENT': 'entertainment',\n",
        "    'COMEDY': 'entertainment',\n",
        "    'ARTS': 'entertainment',\n",
        "    'ARTS & CULTURE': 'entertainment',\n",
        "    'CULTURE & ARTS': 'entertainment',\n",
        "    'STYLE': 'entertainment',\n",
        "    'STYLE & BEAUTY': 'entertainment',\n",
        "    'MEDIA': 'entertainment',\n",
        "    # science (newly split out from tech)\n",
        "    'SCIENCE': 'science',\n",
        "    # health\n",
        "    'WELLNESS': 'health',\n",
        "    'HEALTHY LIVING': 'health',\n",
        "    # crime\n",
        "    'CRIME': 'crime',\n",
        "    # education\n",
        "    'EDUCATION': 'education',\n",
        "    'COLLEGE': 'education',\n",
        "    # environment\n",
        "    'ENVIRONMENT': 'environment',\n",
        "    'GREEN': 'environment',\n",
        "    # travel\n",
        "    'TRAVEL': 'travel',\n",
        "    # religion\n",
        "    'RELIGION': 'religion',\n",
        "}\n",
        "\n",
        "huffpost_df['category'] = huffpost_df['category'].map(category_map)\n",
        "huffpost_df = huffpost_df.dropna(subset=['category'])\n"
      ],
      "metadata": {
        "id": "0jujLtKjXiqm"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 5. COMBINE ----------------\n",
        "df = pd.concat([bbc_df, huffpost_df], ignore_index=True)\n",
        "df['category'] = df['category'].str.lower()\n",
        "\n",
        "print(f\"Combined dataset size: {len(df)} rows across {df['category'].nunique()} categories\")\n",
        "print(df['category'].value_counts())\n",
        "print(\"\\nBy source:\")\n",
        "print(df.groupby(['source', 'category']).size())"
      ],
      "metadata": {
        "id": "WwQq0w_5XyRQ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 6. PREPROCESSING (cleaning + tokenization + lemmatization) ----------------\n",
        "lemmatizer = WordNetLemmatizer()\n",
        "\n",
        "def clean_and_lemmatize(text):\n",
        "    text = text.lower()\n",
        "    text = re.sub(r'[^a-z\\s]', ' ', text)\n",
        "    tokens = word_tokenize(text)\n",
        "    tokens = [lemmatizer.lemmatize(t) for t in tokens if len(t) > 1]\n",
        "    return ' '.join(tokens)\n",
        "\n",
        "print(\"\\nPreprocessing text (cleaning + tokenizing + lemmatizing)...\")\n",
        "df['text'] = df['text'].apply(clean_and_lemmatize)\n",
        "print(\"Done.\")"
      ],
      "metadata": {
        "id": "emZy_xlgX150"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 7. VECTORIZE ----------------\n",
        "vectorizer = TfidfVectorizer(\n",
        "    max_features=10000,\n",
        "    stop_words='english',\n",
        "    ngram_range=(1, 2),\n",
        "    min_df=2,\n",
        "    max_df=0.9,\n",
        "    sublinear_tf=True\n",
        ")\n",
        "X = vectorizer.fit_transform(df['text'])\n",
        "y = df['category']"
      ],
      "metadata": {
        "id": "vb8DClLnX44u"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 8. TEST MULTIPLE SPLITS FOR BEST BIAS-VARIANCE TRADEOFF ----------------\n",
        "splits_to_try = [0.30, 0.25, 0.20]  # -> 70:30, 75:25, 80:20\n",
        "results = []\n",
        "\n",
        "for test_size in splits_to_try:\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y, test_size=test_size, stratify=y, random_state=42\n",
        "    )\n",
        "    model = LogisticRegression(max_iter=1000, class_weight='balanced')\n",
        "    model.fit(X_train, y_train)\n",
        "    preds = model.predict(X_test)\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "    f1 = f1_score(y_test, preds, average='macro')\n",
        "    split_label = f\"{int((1 - test_size) * 100)}:{int(test_size * 100)}\"\n",
        "    results.append({'split': split_label, 'test_size': test_size, 'accuracy': acc, 'macro_f1': f1})\n",
        "    print(f\"Split {split_label} -> Accuracy: {acc:.4f} | Macro F1: {f1:.4f}\")\n",
        "\n",
        "results_df = pd.DataFrame(results).sort_values('macro_f1', ascending=False)\n",
        "print(\"\\n=== Split Comparison (ranked by Macro F1) ===\")\n",
        "print(results_df.to_string(index=False))\n",
        "\n",
        "best_split = results_df.iloc[0]['test_size']\n",
        "print(f\"\\nBest split selected: {int((1 - best_split) * 100)}:{int(best_split * 100)} \"\n",
        "      f\"(highest macro F1 = best bias-variance tradeoff)\")"
      ],
      "metadata": {
        "id": "LJkXvtxLX7Go"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 9. TRAIN FINAL MODEL ON BEST SPLIT ----------------\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=best_split, stratify=y, random_state=42\n",
        ")\n",
        "final_model = LogisticRegression(max_iter=1000, class_weight='balanced')\n",
        "final_model.fit(X_train, y_train)\n",
        "final_preds = final_model.predict(X_test)\n",
        "\n",
        "print(\"\\n=== Final Model Classification Report ===\")\n",
        "print(classification_report(y_test, final_preds))"
      ],
      "metadata": {
        "id": "oLNO3p5YX-NX"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 10. PREDICT FUNCTION WITH PERCENTAGE BREAKDOWN ----------------\n",
        "def classify_headline(headline, top_n=12):\n",
        "    cleaned = clean_and_lemmatize(headline)\n",
        "    vec = vectorizer.transform([cleaned])\n",
        "    probs = final_model.predict_proba(vec)[0]\n",
        "    classes = final_model.classes_\n",
        "    ranked = sorted(zip(classes, probs), key=lambda x: x[1], reverse=True)[:top_n]\n",
        "\n",
        "    print(f\"\\nHeadline: \\\"{headline}\\\"\")\n",
        "    print(\"Predicted category breakdown:\")\n",
        "    for cls, prob in ranked:\n",
        "        print(f\"  {cls:<15} {prob*100:5.2f}%\")\n",
        "    return ranked"
      ],
      "metadata": {
        "id": "SnN69eCOYASH"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 11. TEST ON SAMPLE HEADLINES ----------------\n",
        "sample_headlines = [\n",
        "    \"Apple unveils new AI chip for iPhones\",\n",
        "    \"Messi's business empire expands with new tech investment\",\n",
        "    \"Government announces new policy on sports funding\",\n",
        "    \"Startup uses machine learning to predict stock market crashes\",\n",
        "    \"Jensen Huang took a call from Trump, and showed off something else, too\"\n",
        "]\n",
        "\n",
        "for h in sample_headlines:\n",
        "    classify_headline(h)"
      ],
      "metadata": {
        "id": "q8L3e56vYCRO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------- 12. INTERACTIVE: ASK MORE HEADLINES ----------------\n",
        "while True:\n",
        "    headline = input(\"\\nEnter a headline to classify (or type 'exit' to stop): \")\n",
        "    if headline.lower() == 'exit':\n",
        "        break\n",
        "    classify_headline(headline)"
      ],
      "metadata": {
        "id": "Qb247SsLYELG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(final_model.classes_)\n"
      ],
      "metadata": {
        "id": "KvWwD6Z7axto"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install -q python-docx\n",
        "\n",
        "from docx import Document\n",
        "from docx.shared import Pt, Inches\n",
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "# ---------- 1. Rebuild the exact same test split, keeping row indices ----------\n",
        "idx = np.arange(len(df))\n",
        "idx_train, idx_test = train_test_split(idx, test_size=best_split, stratify=y, random_state=42)\n",
        "\n",
        "audit = df.iloc[idx_test].copy()\n",
        "audit['true'] = y.iloc[idx_test].values\n",
        "audit['pred'] = final_model.predict(X[idx_test])\n",
        "audit['n_words'] = audit['text'].str.split().str.len()\n",
        "median_len = audit['n_words'].median()\n",
        "audit['length_group'] = np.where(audit['n_words'] <= median_len, 'Short', 'Long')\n",
        "\n",
        "overall_acc = accuracy_score(audit['true'], audit['pred'])\n",
        "overall_f1 = f1_score(audit['true'], audit['pred'], average='macro')\n",
        "\n",
        "# ---------- 2. Subgroup audit ----------\n",
        "def subgroup_report(col):\n",
        "    rows = []\n",
        "    for g, sub in audit.groupby(col):\n",
        "        f1 = f1_score(sub['true'], sub['pred'], average='macro',\n",
        "                      labels=sorted(sub['true'].unique()), zero_division=0)\n",
        "        rows.append([g, len(sub), accuracy_score(sub['true'], sub['pred']), f1])\n",
        "    return pd.DataFrame(rows, columns=['Subgroup', 'n', 'Accuracy', 'Macro F1'])\n",
        "\n",
        "len_df = subgroup_report('length_group')\n",
        "src_df = subgroup_report('source')\n",
        "print(\"=== Audit by headline length ===\\n\", len_df.to_string(index=False))\n",
        "print(\"\\n=== Audit by source ===\\n\", src_df.to_string(index=False))\n",
        "\n",
        "len_gap = (len_df['Accuracy'].max() - len_df['Accuracy'].min()) * 100\n",
        "best_len = len_df.loc[len_df['Accuracy'].idxmax(), 'Subgroup']\n",
        "worst_len = len_df.loc[len_df['Accuracy'].idxmin(), 'Subgroup']\n",
        "\n",
        "# ---------- 3. Weakest class + most confused pair ----------\n",
        "report = classification_report(audit['true'], audit['pred'], output_dict=True, zero_division=0)\n",
        "class_f1 = {k: v['f1-score'] for k, v in report.items() if k in final_model.classes_}\n",
        "weakest = min(class_f1, key=class_f1.get)\n",
        "\n",
        "labels = list(final_model.classes_)\n",
        "cm = confusion_matrix(audit['true'], audit['pred'], labels=labels)\n",
        "np.fill_diagonal(cm, 0)\n",
        "i, j = np.unravel_index(cm.argmax(), cm.shape)\n",
        "confused = (labels[i], labels[j], int(cm[i, j]))\n",
        "\n",
        "# ---------- 4. Explainability: top features per class ----------\n",
        "feature_names = np.array(vectorizer.get_feature_names_out())\n",
        "top_feats = {}\n",
        "for k, cls in enumerate(final_model.classes_):\n",
        "    top_idx = np.argsort(final_model.coef_[k])[-5:][::-1]\n",
        "    top_feats[cls] = ', '.join(feature_names[top_idx])\n",
        "print(\"\\n=== Top features per class ===\")\n",
        "for c, f in top_feats.items():\n",
        "    print(f\"{c:<14} {f}\")\n",
        "\n",
        "def explain(headline, k=5):\n",
        "    vec = vectorizer.transform([clean_and_lemmatize(headline)])\n",
        "    probs = final_model.predict_proba(vec)[0]\n",
        "    ci = probs.argmax()\n",
        "    contrib = vec.toarray()[0] * final_model.coef_[ci]\n",
        "    top = [t for t in np.argsort(contrib)[-k:][::-1] if contrib[t] > 0]\n",
        "    return final_model.classes_[ci], probs[ci], [feature_names[t] for t in top]\n",
        "\n",
        "example = \"Apple unveils new AI chip for iPhones\"\n",
        "ex_cls, ex_prob, ex_words = explain(example)\n",
        "print(f\"\\nExample: '{example}' -> {ex_cls} ({ex_prob*100:.1f}%) driven by: {', '.join(ex_words)}\")\n",
        "\n",
        "# ---------- 5. Build the one-page model card ----------\n",
        "doc = Document()\n",
        "for s in doc.sections:\n",
        "    s.top_margin = s.bottom_margin = Inches(0.5)\n",
        "    s.left_margin = s.right_margin = Inches(0.6)\n",
        "doc.styles['Normal'].paragraph_format.space_after = Pt(1)\n",
        "\n",
        "def heading(t):\n",
        "    p = doc.add_paragraph(); r = p.add_run(t); r.bold = True; r.font.size = Pt(10.5)\n",
        "    p.paragraph_format.space_before = Pt(4)\n",
        "\n",
        "def para(t):\n",
        "    p = doc.add_paragraph(); p.add_run(t).font.size = Pt(9)\n",
        "\n",
        "def table(rows, header):\n",
        "    t = doc.add_table(rows=1, cols=len(header)); t.style = 'Table Grid'\n",
        "    for c, h in zip(t.rows[0].cells, header):\n",
        "        c.text = ''; r = c.paragraphs[0].add_run(h); r.bold = True; r.font.size = Pt(8)\n",
        "    for row in rows:\n",
        "        for c, v in zip(t.add_row().cells, row):\n",
        "            c.text = ''; c.paragraphs[0].add_run(str(v)).font.size = Pt(8)\n",
        "\n",
        "title = doc.add_paragraph(); r = title.add_run(\"Model Card: News Headline Classifier\"); r.bold = True; r.font.size = Pt(14)\n",
        "\n",
        "heading(\"1. Model Details\")\n",
        "para(f\"TF-IDF (unigrams+bigrams, 10,000 features) + Logistic Regression (class_weight='balanced'). \"\n",
        "     f\"Preprocessing: lowercasing, tokenization, lemmatization, stopword removal. \"\n",
        "     f\"Predicts one of {len(labels)} categories and returns a probability per category, so mixed-topic headlines show a percentage split. \"\n",
        "     f\"Best train:test split by macro F1: {int((1-best_split)*100)}:{int(best_split*100)}.\")\n",
        "\n",
        "heading(\"2. Intended Use\")\n",
        "para(\"Assigning a topic to short English news headlines. Not intended for fact-checking, moderation, or \"\n",
        "     \"any decision affecting individuals.\")\n",
        "\n",
        "heading(\"3. Data\")\n",
        "src_counts = df['source'].value_counts().to_dict()\n",
        "para(f\"BBC News (2004-05, truncated to first sentence) and HuffPost News Category Dataset (2012-22, headline + short description), \"\n",
        "     f\"merged via a manual category mapping. Rows by source: {src_counts}. Training rows: {len(idx_train)}; test rows: {len(idx_test)}.\")\n",
        "\n",
        "heading(\"4. Performance and Bias Audit\")\n",
        "para(f\"Overall test accuracy: {overall_acc:.3f} | Macro F1: {overall_f1:.3f}. \"\n",
        "     f\"Weakest class: {weakest} (F1 {class_f1[weakest]:.2f}). \"\n",
        "     f\"Most confused pair: true '{confused[0]}' predicted as '{confused[1]}' ({confused[2]} cases).\")\n",
        "rows = [[\"Length\", r_['Subgroup'], r_['n'], f\"{r_['Accuracy']:.3f}\", f\"{r_['Macro F1']:.3f}\"] for _, r_ in len_df.iterrows()]\n",
        "rows += [[\"Source\", r_['Subgroup'], r_['n'], f\"{r_['Accuracy']:.3f}\", f\"{r_['Macro F1']:.3f}\"] for _, r_ in src_df.iterrows()]\n",
        "table(rows, [\"Audit axis\", \"Subgroup\", \"n\", \"Accuracy\", \"Macro F1\"])\n",
        "para(f\"Key finding: {best_len} inputs score {len_gap:.1f} points higher in accuracy than {worst_len} inputs \"\n",
        "     f\"(split at the median of {median_len:.0f} words after cleaning). Source comparison is not like-for-like: \"\n",
        "     f\"BBC rows cover only 5 categories, HuffPost covers all {len(labels)}.\")\n",
        "\n",
        "heading(\"5. Explainability (top TF-IDF features per class, from model coefficients)\")\n",
        "table([[c, f] for c, f in top_feats.items()], [\"Class\", \"Top 5 words\"])\n",
        "para(f\"Example: \\\"{example}\\\" -> {ex_cls} ({ex_prob*100:.1f}%), driven by: {', '.join(ex_words)}.\")\n",
        "\n",
        "heading(\"6. Limitations\")\n",
        "para(f\"- Temporal: training text ends in 2022 (BBC in 2005), so newer entities are out-of-vocabulary and fall back on generic words.\")\n",
        "para(f\"- Bag-of-words has no world knowledge, so '{confused[0]}' vs '{confused[1]}' overlap causes the most errors.\")\n",
        "para(\"- Taxonomy: mapping HuffPost's ~42 labels into 12 involved judgment calls, and 7 categories come only from HuffPost.\")\n",
        "para(\"- Trained on US-centric, HuffPost-style writing; performance on other regions or styles is untested.\")\n",
        "\n",
        "doc.save(\"Model_Card.docx\")\n",
        "files.download(\"Model_Card.docx\")"
      ],
