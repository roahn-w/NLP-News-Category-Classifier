    {
      "cell_type": "code",
      "source": [
        "!pip install -q lime\n",
        "\n",
        "from lime.lime_text import LimeTextExplainer\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "class_names = list(final_model.classes_)\n",
        "\n",
        "# LIME needs a function: list of raw strings -> probability matrix\n",
        "def predict_proba_raw(texts):\n",
        "    cleaned = [clean_and_lemmatize(t) for t in texts]\n",
        "    return final_model.predict_proba(vectorizer.transform(cleaned))\n",
        "\n",
        "explainer = LimeTextExplainer(class_names=class_names, random_state=42)\n",
        "\n",
        "def lime_explain(headline, num_features=8, save_as=None):\n",
        "    probs = predict_proba_raw([headline])[0]\n",
        "    top_idx = int(np.argmax(probs))\n",
        "    top_class = class_names[top_idx]\n",
        "\n",
        "    exp = explainer.explain_instance(\n",
        "        headline, predict_proba_raw,\n",
        "        num_features=num_features, labels=[top_idx], num_samples=1000\n",
        "    )\n",
        "\n",
        "    print(f\"\\nHeadline: \\\"{headline}\\\"\")\n",
        "    print(f\"Predicted: {top_class} ({probs[top_idx]*100:.1f}%)\")\n",
        "    print(\"Word contributions (positive = pushes toward predicted class, negative = pushes away):\")\n",
        "    for word, weight in exp.as_list(label=top_idx):\n",
        "        print(f\"  {word:<15} {weight:+.4f}\")\n",
        "\n",
        "    fig = exp.as_pyplot_figure(label=top_idx)\n",
        "    plt.title(f\"LIME: why '{top_class}' ({probs[top_idx]*100:.1f}%)\")\n",
        "    plt.tight_layout()\n",
        "    if save_as:\n",
        "        fig.savefig(save_as, dpi=200, bbox_inches='tight')\n",
        "    plt.show()\n",
        "\n",
        "# ---------- Run on a few headlines: one clear case, one mixed case, one failure case ----------\n",
        "lime_explain(\"Apple unveils new AI chip for iPhones\", save_as=\"lime_apple.png\")\n",
        "lime_explain(\"Messi's business empire expands with new tech investment\", save_as=\"lime_messi.png\")\n",
        "lime_explain(\"Jensen Huang took a call from Trump, and showed off something else, too\", save_as=\"lime_jensen.png\")"
      ],
      "metadata": {
        "id": "J5Vswm1kuM3X"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Bars pointing one way show words that push the model toward the predicted category. Bars pointing the other way show words that push against it.\n",
        "Each headline takes roughly 10-30 seconds, because LIME re-runs the model on about 1,000 perturbed versions of the headline.\n"
      ],
      "metadata": {
        "id": "3KzJcok1upn5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install -q python-docx lime\n",
        "\n",
        "import sys, re\n",
        "import importlib.metadata as md\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from docx import Document\n",
        "from docx.shared import Pt, Inches\n",
        "from docx.oxml.ns import qn\n",
        "from docx.oxml import OxmlElement\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.dummy import DummyClassifier\n",
        "from sklearn.metrics import accuracy_score, f1_score, precision_score, recall_score, confusion_matrix\n",
        "from lime.lime_text import LimeTextExplainer\n",
        "from google.colab import files\n",
        "import sklearn\n",
        "\n",
        "# ================= SETTINGS YOU CAN EDIT =================\n",
        "MODEL_NAME = \"HeadlineTopic-v1\"\n",
        "AUTHORS    = \"Rohan Waghade, Twisha Shukla, Aarushi Sharma\"\n",
        "DATE_TEXT  = \"October 2026\"\n",
        "TOP_FEATS  = 5      # top words listed per topic (use 3 to shorten the card)\n",
        "LOW_CONF   = 0.5    # predictions with top probability below this count as low confidence\n",
        "# =========================================================\n",
        "\n",
        "# ---------- 1. Rebuild the exact test split used for the final model ----------\n",
        "idx_all = np.arange(len(df))\n",
        "idx_train, idx_test = train_test_split(idx_all, test_size=best_split, stratify=y, random_state=42)\n",
        "classes = list(final_model.classes_)\n",
        "X_train, X_test = X[idx_train], X[idx_test]\n",
        "y_train, y_test = y.iloc[idx_train].values, y.iloc[idx_test].values\n",
        "proba = final_model.predict_proba(X_test)\n",
        "pred = np.array(classes)[proba.argmax(axis=1)]\n",
        "conf = proba.max(axis=1)\n",
        "n_train, n_test = len(idx_train), len(idx_test)\n",
        "\n",
        "# ---------- 2. Overall performance and majority class baseline ----------\n",
        "def macro(yt, yp):\n",
        "    return (accuracy_score(yt, yp),\n",
        "            precision_score(yt, yp, average=\"macro\", zero_division=0),\n",
        "            recall_score(yt, yp, average=\"macro\", zero_division=0),\n",
        "            f1_score(yt, yp, average=\"macro\", zero_division=0))\n",
        "\n",
        "m_acc, m_prec, m_rec, m_f1 = macro(y_test, pred)\n",
        "dummy = DummyClassifier(strategy=\"most_frequent\").fit(X_train, y_train)\n",
        "b_acc, b_prec, b_rec, b_f1 = macro(y_test, dummy.predict(X_test))\n",
        "diff_pts = (m_acc - b_acc) * 100\n",
        "\n",
        "# ---------- 3. Raw text for the audit (cleaned text has digits and capitals removed) ----------\n",
        "try:\n",
        "    raw_all = pd.concat([bbc_df[\"text\"], huffpost_df[\"text\"]], ignore_index=True)\n",
        "    assert len(raw_all) == len(df)\n",
        "    raw_text = raw_all.iloc[idx_test].reset_index(drop=True)\n",
        "    raw_ok = True\n",
        "except Exception:\n",
        "    raw_text = df[\"text\"].iloc[idx_test].reset_index(drop=True)\n",
        "    raw_ok = False\n",
        "\n",
        "audit = pd.DataFrame({\"true\": y_test, \"pred\": pred, \"text\": raw_text.values})\n",
        "audit[\"tokens\"] = audit[\"text\"].str.split().str.len()\n",
        "if raw_ok:\n",
        "    audit[\"has_digit\"] = audit[\"text\"].str.contains(r\"\\d\")\n",
        "has_source = \"source\" in df.columns\n",
        "if has_source:\n",
        "    audit[\"source\"] = df[\"source\"].iloc[idx_test].values\n",
        "thr = int(np.median(audit[\"tokens\"]))\n",
        "\n",
        "# ---------- 4. Subgroup audit ----------\n",
        "def sg(mask):\n",
        "    sub = audit[mask]\n",
        "    if len(sub) == 0:\n",
        "        return None\n",
        "    f1 = f1_score(sub[\"true\"], sub[\"pred\"], average=\"macro\",\n",
        "                  labels=sorted(sub[\"true\"].unique()), zero_division=0)\n",
        "    return len(sub), accuracy_score(sub[\"true\"], sub[\"pred\"]), f1\n",
        "\n",
        "groups = [\n",
        "    (\"Short headlines\", f\"Fewer than {thr} words\", audit[\"tokens\"] < thr),\n",
        "    (\"Long headlines\", f\"{thr} words or more\", audit[\"tokens\"] >= thr),\n",
        "]\n",
        "if raw_ok:\n",
        "    groups += [\n",
        "        (\"Contains a number\", \"Has at least one digit (year, figure, age)\", audit[\"has_digit\"]),\n",
        "        (\"No number\", \"No digits in the text\", ~audit[\"has_digit\"]),\n",
        "    ]\n",
        "if has_source:\n",
        "    groups += [\n",
        "        (\"BBC source\", \"Row came from the BBC dataset\", audit[\"source\"] == \"bbc\"),\n",
        "        (\"HuffPost source\", \"Row came from the HuffPost dataset\", audit[\"source\"] == \"huffpost\"),\n",
        "    ]\n",
        "\n",
        "sg_rows, sg_res = [], {}\n",
        "for name, definition, mask in groups:\n",
        "    r = sg(mask)\n",
        "    if r is None:\n",
        "        continue\n",
        "    sg_res[name] = r\n",
        "    sg_rows.append([name, definition, f\"{r[0]:,}\", f\"{r[1]*100:.1f}%\", f\"{r[2]:.3f}\"])\n",
        "\n",
        "# key finding: biggest accuracy gap among like for like pairs\n",
        "pairs = [(\"Short headlines\", \"Long headlines\"), (\"Contains a number\", \"No number\")]\n",
        "best_gap = None\n",
        "for a, b in pairs:\n",
        "    if a in sg_res and b in sg_res:\n",
        "        gap = abs(sg_res[a][1] - sg_res[b][1]) * 100\n",
        "        lo, hi = (a, b) if sg_res[a][1] < sg_res[b][1] else (b, a)\n",
        "        if best_gap is None or gap > best_gap[0]:\n",
        "            best_gap = (gap, lo, hi)\n",
        "if best_gap:\n",
        "    gap, lo, hi = best_gap\n",
        "    key_finding = (f\"Accuracy is {gap:.1f} points lower for \\\"{lo}\\\" ({sg_res[lo][1]*100:.1f}%) \"\n",
        "                   f\"than for \\\"{hi}\\\" ({sg_res[hi][1]*100:.1f}%).\")\n",
        "else:\n",
        "    key_finding = \"Subgroup gaps could not be computed from the available columns.\"\n",
        "lowest = min(sg_res, key=lambda k: sg_res[k][1])\n",
        "lowest_line = (f\"The lowest scoring subgroup is \\\"{lowest}\\\" \"\n",
        "               f\"(accuracy {sg_res[lowest][1]*100:.1f}%, n = {sg_res[lowest][0]:,}).\")\n",
        "min_n = min(v[0] for v in sg_res.values())\n",
        "\n",
        "# per topic F1, weakest class, most confused pair\n",
        "topic_f1 = {c: f1_score(y_test, pred, labels=[c], average=\"macro\", zero_division=0) for c in classes}\n",
        "weakest = min(topic_f1, key=topic_f1.get)\n",
        "cm = confusion_matrix(y_test, pred, labels=classes)\n",
        "cm_off = cm.copy()\n",
        "np.fill_diagonal(cm_off, 0)\n",
        "ci, cj = np.unravel_index(cm_off.argmax(), cm_off.shape)\n",
        "topic_line = \", \".join(f\"{c} {v:.2f}\" for c, v in sorted(topic_f1.items(), key=lambda kv: -kv[1]))\n",
        "test_counts = pd.Series(y_test).value_counts()\n",
        "\n",
        "# low confidence statistics\n",
        "low = conf < LOW_CONF\n",
        "if low.sum() > 0 and (~low).sum() > 0:\n",
        "    low_acc = accuracy_score(y_test[low], pred[low]) * 100\n",
        "    hi_acc = accuracy_score(y_test[~low], pred[~low]) * 100\n",
        "    low_line = (f\"Route low confidence predictions (top probability below {LOW_CONF}) to a person. \"\n",
        "                f\"They are {low.mean()*100:.1f}% of the test set and score {low_acc:.1f}% accuracy, \"\n",
        "                f\"against {hi_acc:.1f}% for the rest.\")\n",
        "else:\n",
        "    low_line = (f\"Route low confidence predictions (top probability below {LOW_CONF}) to a person. \"\n",
        "                f\"No test predictions fell in that range for this model.\")\n",
        "\n",
        "# ---------- 5. Explainability: top features per topic ----------\n",
        "feat_names = np.array(vectorizer.get_feature_names_out())\n",
        "feat_rows = []\n",
        "for k, c in enumerate(classes):\n",
        "    top = np.argsort(final_model.coef_[k])[-TOP_FEATS:][::-1]\n",
        "    feat_rows.append([c, \", \".join(f\"{feat_names[t]} (+{final_model.coef_[k][t]:.1f})\" for t in top)])\n",
        "\n",
        "# ---------- 6. Explainability: LIME on the most confidently wrong test headline ----------\n",
        "def predict_raw(texts):\n",
        "    return final_model.predict_proba(vectorizer.transform([clean_and_lemmatize(t) for t in texts]))\n",
        "\n",
        "wrong = np.where(pred != y_test)[0]\n",
        "lime_ok = len(wrong) > 0\n",
        "if lime_ok:\n",
        "    pred_idx = np.array([classes.index(p) for p in pred])\n",
        "    pick = wrong[proba[wrong, pred_idx[wrong]].argmax()]\n",
        "    p_i, t_i = pred_idx[pick], classes.index(y_test[pick])\n",
        "    explainer = LimeTextExplainer(class_names=classes, random_state=42)\n",
        "    exp = explainer.explain_instance(df[\"text\"].iloc[idx_test[pick]], predict_raw,\n",
        "                                     num_features=8, labels=[p_i, t_i], num_samples=1000)\n",
        "    pos_pred = [(w, v) for w, v in exp.as_list(label=p_i) if v > 0][:3]\n",
        "    pos_true = [(w, v) for w, v in exp.as_list(label=t_i) if v > 0][:3]\n",
        "    shown = audit[\"text\"].iloc[pick]\n",
        "    shown = shown if len(shown) <= 220 else shown[:220] + \"...\"\n",
        "    fmt_w = lambda lst: \", \".join(f\"{w} ({v:+.2f})\" for w, v in lst) if lst else \"none above zero\"\n",
        "\n",
        "# ---------- 7. Header facts from the trained objects ----------\n",
        "def ver(pkg):\n",
        "    try:\n",
        "        return md.version(pkg)\n",
        "    except Exception:\n",
        "        return \"unknown\"\n",
        "\n",
        "ng = vectorizer.ngram_range\n",
        "ng_text = \"unigrams and bigrams\" if tuple(ng) == (1, 2) else f\"n grams {ng}\"\n",
        "train_src = (df[\"source\"].iloc[idx_train].value_counts().to_dict() if has_source else {})\n",
        "src_text = \", \".join(f\"{k} {v:,}\" for k, v in train_src.items()) if train_src else \"source column not found\"\n",
        "train_pct = int(round((1 - best_split) * 100)); test_pct = int(round(best_split * 100))\n",
        "\n",
        "# ---------- 8. Build the model card document ----------\n",
        "doc = Document()\n",
        "for s in doc.sections:\n",
        "    s.top_margin = s.bottom_margin = Inches(0.5)\n",
        "    s.left_margin = s.right_margin = Inches(0.6)\n",
        "st = doc.styles[\"Normal\"]\n",
        "st.font.name = \"Calibri\"\n",
        "st.font.size = Pt(9)\n",
        "st.paragraph_format.space_after = Pt(2)\n",
        "\n",
        "def run_fmt(r, size, bold=False, italic=False):\n",
        "    r.font.size = Pt(size); r.bold = bold; r.italic = italic\n",
        "    r.font.name = \"Calibri\"\n",
        "    r._r.get_or_add_rPr().rFonts.set(qn(\"w:eastAsia\"), \"Calibri\")\n",
        "\n",
        "def heading(t):\n",
        "    p = doc.add_paragraph(); p.paragraph_format.space_before = Pt(7)\n",
        "    p.paragraph_format.keep_with_next = True\n",
        "    run_fmt(p.add_run(t), 11, True)\n",
        "\n",
        "def para(t, bold=False, italic=False, size=9):\n",
        "    p = doc.add_paragraph(); run_fmt(p.add_run(t), size, bold, italic); return p\n",
        "\n",
        "def bullet(label, text):\n",
        "    p = doc.add_paragraph(); p.paragraph_format.left_indent = Inches(0.2)\n",
        "    p.paragraph_format.first_line_indent = Inches(-0.15)\n",
        "    run_fmt(p.add_run(\"\\u2022 \"), 9, True)\n",
        "    if label:\n",
        "        run_fmt(p.add_run(label + \" \"), 9, True)\n",
        "    run_fmt(p.add_run(text), 9)\n",
        "\n",
        "def table(header, rows, widths):\n",
        "    t = doc.add_table(rows=1, cols=len(header)); t.style = \"Table Grid\"\n",
        "    t.autofit = False\n",
        "    lay = OxmlElement(\"w:tblLayout\"); lay.set(qn(\"w:type\"), \"fixed\")\n",
        "    look = t._tbl.tblPr.find(qn(\"w:tblLook\"))\n",
        "    (look.addprevious(lay) if look is not None else t._tbl.tblPr.append(lay))\n",
        "    def fill(cell, text, bold, w):\n",
        "        cell.width = Inches(w); cell.text = \"\"\n",
        "        run_fmt(cell.paragraphs[0].add_run(str(text)), 8.5, bold)\n",
        "        cell.paragraphs[0].paragraph_format.space_after = Pt(0)\n",
        "    for c, h, w in zip(t.rows[0].cells, header, widths):\n",
        "        fill(c, h, True, w)\n",
        "        shd = OxmlElement(\"w:shd\"); shd.set(qn(\"w:val\"), \"clear\"); shd.set(qn(\"w:fill\"), \"E7E6E6\")\n",
        "        c._tc.get_or_add_tcPr().append(shd)\n",
        "    for row in rows:\n",
        "        cells = t.add_row().cells\n",
        "        for c, v, w in zip(cells, row, widths):\n",
        "            fill(c, v, False, w)\n",
        "    for col, w in zip(t.columns, widths):\n",
        "        col.width = Inches(w)\n",
        "    doc.add_paragraph().paragraph_format.space_after = Pt(0)\n",
        "\n",
        "p = doc.add_paragraph(); run_fmt(p.add_run(f\"Model Card: {MODEL_NAME}\"), 15, True)\n",
        "\n",
        "heading(\"1. Model details\")\n",
        "table([\"Field\", \"Description\"], [\n",
        "    [\"Model name\", MODEL_NAME],\n",
        "    [\"Task\", f\"Multi class topic classification of English news headlines into {len(classes)} topics, \"\n",
        "             f\"returning a percentage for every topic\"],\n",
        "    [\"Model\", f\"TFIDF ({ng_text}, {vectorizer.max_features:,} features, min_df {vectorizer.min_df}, \"\n",
        "              f\"max_df {vectorizer.max_df}, sublinear_tf {vectorizer.sublinear_tf}) + Logistic Regression \"\n",
        "              f\"(C = {final_model.C}, class_weight = {final_model.class_weight})\"],\n",
        "    [\"Training data\", f\"BBC News (2004 to 2005) and HuffPost News Category Dataset (2012 to 2022), merged by a manual \"\n",
        "                      f\"category mapping. {n_train:,} training rows ({src_text}) across {len(classes)} topics\"],\n",
        "    [\"Test data\", f\"{n_test:,} held out headlines (stratified {train_pct}:{test_pct} split, random seed 42). \"\n",
        "                  f\"The split was chosen from 70:30, 75:25 and 80:20 by macro F1\"],\n",
        "    [\"Preprocessing\", \"BBC articles cut to their first sentence; HuffPost headline plus short description; lowercasing; \"\n",
        "                      \"non letters removed; NLTK tokenization and WordNet lemmatization; English stop words removed\"],\n",
        "    [\"Libraries\", f\"Python {sys.version.split()[0]}, scikit-learn {sklearn.__version__}, NLTK {ver('nltk')}, \"\n",
        "                  f\"pandas {ver('pandas')}, LIME {ver('lime')}\"],\n",
        "    [\"Developed by\", f\"{AUTHORS}, SAII, NLP course, {DATE_TEXT}\"],\n",
        "], [1.3, 5.9])\n",
        "\n",
        "heading(\"2. Intended use\")\n",
        "bullet(\"Intended:\", \"Assigning topic percentages to short English news headlines, for example to help sort a feed; \"\n",
        "       \"classroom demonstration of a classical NLP pipeline.\")\n",
        "bullet(\"Out of scope:\", \"Decisions about individual people; non English or code mixed text; fact checking or \"\n",
        "       f\"moderation; topics outside the {len(classes)} labels; news about events after 2022, which the training text does not cover.\")\n",
        "\n",
        "heading(\"3. Overall performance\")\n",
        "sign = \"beating\" if diff_pts >= 0 else \"trailing\"\n",
        "para(f\"The model reaches {m_acc*100:.1f}% accuracy and {m_f1:.3f} macro F1 on the {n_test:,} headline test set, \"\n",
        "     f\"{sign} a majority class baseline ({b_acc*100:.1f}%) by {abs(diff_pts):.1f} points.\")\n",
        "table([\"Model\", \"Accuracy\", \"Precision\", \"Recall\", \"Macro F1\"], [\n",
        "    [\"Majority class baseline\", f\"{b_acc*100:.1f}%\", f\"{b_prec:.3f}\", f\"{b_rec:.3f}\", f\"{b_f1:.3f}\"],\n",
        "    [f\"{MODEL_NAME} (TFIDF + LR)\", f\"{m_acc*100:.1f}%\", f\"{m_prec:.3f}\", f\"{m_rec:.3f}\", f\"{m_f1:.3f}\"],\n",
        "], [2.4, 1.2, 1.2, 1.2, 1.2])\n",
        "para(\"Precision and recall are macro averages over the topics.\", italic=True, size=8)\n",
        "\n",
        "heading(\"4. Performance across text subgroups\")\n",
        "para(\"Key audit finding: \" + key_finding + \" \" + lowest_line, bold=True)\n",
        "table([\"Subgroup / style\", \"How it was defined\", \"Test size (n)\", \"Accuracy\", \"Macro F1\"], sg_rows,\n",
        "      [1.5, 2.9, 0.9, 0.9, 0.9])\n",
        "para(\"F1 by topic: \" + topic_line + \".\", size=8.5)\n",
        "n_bbc_topics = df.loc[df[\"source\"] == \"bbc\", \"category\"].nunique() if has_source else \"?\"\n",
        "n_hp_topics = df.loc[df[\"source\"] == \"huffpost\", \"category\"].nunique() if has_source else \"?\"\n",
        "note = (\"Length and number groups are not controlled for source. \"\n",
        "        f\"BBC covers {n_bbc_topics} topics and HuffPost {n_hp_topics}, so source scores are not like for like.\")\n",
        "if not raw_ok:\n",
        "    note += \" Raw text could not be rebuilt, so the number subgroup was skipped and length was counted on cleaned text.\"\n",
        "para(note, italic=True, size=8)\n",
        "\n",
        "heading(\"5. Explainability check\")\n",
        "para(\"Method 1: Top features (Logistic Regression coefficients). Words with the largest positive weight for each topic.\", bold=True)\n",
        "table([\"Topic\", f\"Top {TOP_FEATS} features (weight)\"], feat_rows, [1.2, 6.0])\n",
        "if lime_ok:\n",
        "    para(\"Method 2: LIME on the most confidently misclassified test headline.\", bold=True)\n",
        "    bullet(\"Headline:\", f\"\\\"{shown}\\\" (true label: {y_test[pick]}; predicted: {pred[pick]}, p = {proba[pick, p_i]:.2f})\")\n",
        "    bullet(\"LIME:\", f\"words pushing toward the predicted topic '{pred[pick]}': {fmt_w(pos_pred)}. \"\n",
        "           f\"Words pushing toward the true topic '{y_test[pick]}': {fmt_w(pos_true)}.\")\n",
        "    bullet(\"Interpretation:\", \"Write one sentence here explaining why these words led the model astray, \"\n",
        "           \"after checking the LIME plot.\")\n",
        "else:\n",
        "    para(\"No misclassified test headlines were found, so the LIME example was skipped.\")\n",
        "\n",
        "heading(\"6. Limitations and ethical considerations\")\n",
        "bullet(\"Main limitation:\", \"The model matches words to topics and has no world knowledge, so a person or company \"\n",
        "       \"absent from the training text adds no signal. A BBC only baseline gave a nearly flat spread across topics \"\n",
        "       \"(top topic 29.1%) for a headline naming two such people.\")\n",
        "bullet(\"Data bias:\", \"Training text comes from two outlets, BBC (2004 to 2005) and HuffPost (2012 to 2022). \"\n",
        "       \"Names, events and writing style after 2022 are unseen.\")\n",
        "bullet(\"Label choices:\", f\"About 42 HuffPost labels were mapped by hand to {len(classes)} topics, and labels with no clear match were \"\n",
        "       \"dropped. Each headline has one label, so headlines that truly mix topics are scored against one answer.\")\n",
        "bullet(\"Weak spots:\", f\"Lowest F1 topic: {weakest} ({topic_f1[weakest]:.2f}). Most confused pair: true \"\n",
        "       f\"'{classes[ci]}' predicted as '{classes[cj]}' ({cm_off[ci, cj]} cases). Test set sizes range from \"\n",
        "       f\"{test_counts.min():,} ({test_counts.idxmin()}) to {test_counts.max():,} ({test_counts.idxmax()}) headlines; \"\n",
        "       f\"balanced class weights were used.\")\n",
        "bullet(\"Split selection:\", \"The split was chosen using test macro F1, so the reported score is slightly optimistic.\")\n",
        "if min_n < 300:\n",
        "    bullet(\"Small audit sample:\", f\"The smallest subgroup has only {min_n:,} headlines, so its estimate is less precise.\")\n",
        "\n",
        "heading(\"7. Recommendations\")\n",
        "bullet(\"\", \"Add recent headlines (2023 onward) to training and re run the same subgroup audit.\")\n",
        "bullet(\"\", \"Replace person, organization and place names with entity tags (for example with spaCy) before vectorizing.\")\n",
        "bullet(\"\", \"Try a contextual model such as a fine tuned DistilBERT and compare it using the same audit.\")\n",
        "bullet(\"\", low_line)\n",
        "\n",
        "out_name = \"Model_Card_Headline_Classifier.docx\"\n",
        "doc.save(out_name)\n",
        "print(f\"Overall: accuracy {m_acc*100:.1f}%, macro F1 {m_f1:.3f}, test rows {n_test:,}\")\n",
        "print(pd.DataFrame(sg_rows, columns=[\"Subgroup\", \"Definition\", \"n\", \"Accuracy\", \"Macro F1\"]).to_string(index=False))\n",
        "files.download(out_name)"
      ],
      "metadata": {
        "id": "WSxDtaWw5au4"
      },
